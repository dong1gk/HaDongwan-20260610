# OpenAI API 키 (백엔드에서만 사용, 프론트엔드에 노출 금지)
OPENAI_API_KEY=your_api_key_here

# 사용할 모델 (미설정 시 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# 서버 포트
PORT=5001

# CORS 허용 출처 (배포된 프론트엔드 주소)
CLIENT_ORIGIN=http://localhost:5173

# 크롤링 대상 URL (쉼표 구분, 미설정 시 기본 위키백과 성분 페이지 사용)
# CRAWL_URLS=https://ko.wikipedia.org/wiki/루테인,https://ko.wikipedia.org/wiki/마그네슘
